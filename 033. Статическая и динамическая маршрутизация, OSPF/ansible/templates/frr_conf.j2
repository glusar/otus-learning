frr version 8.1
frr defaults traditional
hostname {{ ansible_facts['hostname'] }}
log syslog informational
no ipv6 forwarding
service integrated-vtysh-config
!
interface eth1
{% if ansible_facts['hostname'] == 'router1' %}
 description r1-r2
{% elif ansible_facts['hostname'] == 'router2' %}
 description r1-r2
{% elif ansible_facts['hostname'] == 'router3' %}
 description r2-r3
{% endif %}
 ip address {{ ansible_facts['eth1']['ipv4']['address'] }}/30
 ip ospf mtu-ignore
{% if ansible_facts['hostname'] == 'router1' %}
 ip ospf cost 1000
{% elif ansible_facts['hostname'] == 'router2' and symmetric_routing == true %}
 ip ospf cost 1000
{% else %}
 !ip ospf cost 450
{% endif %}
 ip ospf hello-interval 10
 ip ospf dead-interval 30
!
interface eth2
{% if ansible_facts['hostname'] == 'router1' %}
 description r1-r3
{% elif ansible_facts['hostname'] == 'router2' %}
 description r2-r3
{% elif ansible_facts['hostname'] == 'router3' %}
 description r1-r3
{% endif %}
 ip address {{ ansible_facts['eth2']['ipv4']['address'] }}/30
 ip ospf mtu-ignore
 !ip ospf cost 45
 ip ospf hello-interval 10
 ip ospf dead-interval 30

interface eth3
{% if ansible_facts['hostname'] == 'router1' %}
 description net_router1
{% elif ansible_facts['hostname'] == 'router2' %}
 description net_router2
{% elif ansible_facts['hostname'] == 'router3' %}
 description net_router3
{% endif %}
 ip address {{ ansible_facts['eth3']['ipv4']['address'] }}/24
 ip ospf mtu-ignore
 !ip ospf cost 45
 ip ospf hello-interval 10
 ip ospf dead-interval 30 
!
router ospf
 {% if router_id_enable == false %}!{% endif %}router-id {{ router_id }}
 network {{ ansible_facts['eth1']['ipv4']['network'] }}/30 area 0
 network {{ ansible_facts['eth2']['ipv4']['network'] }}/30 area 0
 network {{ ansible_facts['eth3']['ipv4']['network'] }}/24 area 0 
{% if ansible_facts['hostname'] == 'router1' %}
 neighbor 10.0.10.2
 neighbor 10.0.12.2
{% elif ansible_facts['hostname'] == 'router2' %}
 neighbor 10.0.10.1
 neighbor 10.0.11.1
{% elif ansible_facts['hostname'] == 'router3' %}
 neighbor 10.0.11.2
 neighbor 10.0.12.1
{% endif %}

log file /var/log/frr/frr.log
default-information originate always
