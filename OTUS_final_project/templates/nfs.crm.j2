primitive p_ncfs ocf:heartbeat:Filesystem \
    params device=/dev/drbd0 directory={{ project_storage_path }} fstype=ext4 \
    op start interval=0 timeout=60s \
    op stop interval=0 timeout=60s \
    op monitor interval=20s timeout=40s

primitive p_storage_vip ocf:heartbeat:IPaddr2 \
    params ip={{ project_service_vip }} cidr_netmask=24 nic=eth0 \
    op monitor interval=10s timeout=20s

primitive p_nfs ocf:heartbeat:nfsserver \
    params nfs_shared_infodir={{ project_storage_path }}/.nfs-state \
        nfs_ip={{ project_service_vip }} nfs_server_scope={{ cluster_name }}-nfs nfsv4_only=true \
    op start interval=0 timeout=120s \
    op stop interval=0 timeout=120s \
    op monitor interval=20s timeout=40s

primitive p_nfs_export ocf:heartbeat:exportfs \
    params directory={{ project_nfs_export }} clientspec={{ project_networks.internal.cidr }} \
        options="rw,sync,no_subtree_check,root_squash" fsid=1 \
        wait_for_leasetime_on_stop=true \
    op start interval=0 timeout=60s \
    op stop interval=0 timeout=120s \
    op monitor interval=20s timeout=40s

group g_storage p_ncfs p_storage_vip p_nfs p_nfs_export \
    meta resource-stickiness=1000

colocation c_storage_on_drbd inf: g_storage cl_drbd_{{ drbd_resource }}:Promoted
order o_drbd_before_storage Mandatory: cl_drbd_{{ drbd_resource }}:promote g_storage:start
