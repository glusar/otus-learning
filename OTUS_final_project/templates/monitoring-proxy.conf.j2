map $http_upgrade $otus_monitoring_connection {
    default upgrade;
    '' close;
}

server {
    listen {{ dmz_ip }}:{{ monitoring_web_port }} ssl;
    server_name {{ dmz_ip }};
    ssl_certificate /etc/nginx/ssl/nextcloud.crt;
    ssl_certificate_key /etc/nginx/ssl/nextcloud.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    allow {{ project_admin_ip }};
    deny all;

    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;

    location = / {
        return 302 /grafana/;
    }

    location /grafana/ {
        proxy_pass http://{{ hostvars[groups['monitoring'][0]].internal_ip }}:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $otus_monitoring_connection;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /prometheus/ {
        proxy_pass http://{{ hostvars[groups['monitoring'][0]].internal_ip }}:9090/;
    }

    location /alertmanager/ {
        proxy_pass http://{{ hostvars[groups['monitoring'][0]].internal_ip }}:9093/;
    }
}

server {
    listen {{ dmz_ip }}:{{ ntfy_web_port }} ssl;
    server_name {{ dmz_ip }};
    ssl_certificate /etc/nginx/ssl/nextcloud.crt;
    ssl_certificate_key /etc/nginx/ssl/nextcloud.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    allow {{ project_admin_ip }};
    deny all;

    location / {
        proxy_pass http://{{ hostvars[groups['monitoring'][0]].internal_ip }}:{{ ntfy_http_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $otus_monitoring_connection;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
