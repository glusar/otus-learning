upstream nextcloud_web {
{% for backend in groups['backends'] %}
    server {{ hostvars[backend].internal_ip }}:80 max_fails=2 fail_timeout=10s;
{% endfor %}
    keepalive 16;
}

server {
    listen {{ dmz_ip }}:80;
    listen {{ internal_ip }}:80;
    server_name {{ project_domain }};
    return 301 https://{{ project_domain }}$request_uri;
}

server {
    listen {{ dmz_ip }}:443 ssl;
    listen {{ internal_ip }}:443 ssl;
    server_name {{ project_domain }};
    ssl_certificate /etc/nginx/ssl/nextcloud.crt;
    ssl_certificate_key /etc/nginx/ssl/nextcloud.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 512m;
    client_body_timeout 600s;
    add_header Strict-Transport-Security "max-age=15552000" always;

    location = /.well-known/carddav { return 301 https://{{ project_domain }}/remote.php/dav/; }
    location = /.well-known/caldav { return 301 https://{{ project_domain }}/remote.php/dav/; }
    location / {
        proxy_pass http://nextcloud_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host {{ project_domain }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}
