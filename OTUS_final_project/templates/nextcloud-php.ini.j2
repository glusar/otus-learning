memory_limit=512M
upload_max_filesize=512M
post_max_size=512M
max_execution_time=300
max_input_time=300
date.timezone={{ project_timezone }}
expose_php=Off
opcache.enable=1
opcache.enable_cli=1
opcache.memory_consumption=192
opcache.interned_strings_buffer=32
opcache.max_accelerated_files=20000
opcache.save_comments=1
apc.enable_cli=1
session.save_handler=redis
session.save_path="tcp://{{ project_service_vip }}:6379?auth={{ vault_redis_password }}&database=1&timeout=2.5&read_timeout=2.5"
redis.session.locking_enabled=1
redis.session.lock_retries=-1
redis.session.lock_wait_time=20000
redis.session.lock_expire=600
