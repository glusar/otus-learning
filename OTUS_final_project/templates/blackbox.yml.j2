modules:
  nextcloud_https:
    prober: http
    timeout: 8s
    http:
      preferred_ip_protocol: ip4
      follow_redirects: false
      fail_if_not_ssl: true
      fail_if_body_not_matches_regexp:
        - 'data-requesttoken="[^"]+"'
      headers:
        Host: {{ project_domain }}
      tls_config:
        ca_file: /etc/prometheus/otus-nextcloud.crt
        server_name: {{ project_domain }}
  tcp_connect:
    prober: tcp
    timeout: 4s
